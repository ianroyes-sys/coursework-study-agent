# Copy to .env.local and fill in. Every variable is optional for the demo (npm run seed).

# Your Brightspace tenant, e.g. https://yourschool.desire2learn.com (no trailing slash).
# Required only for the live "Refresh from D2L" button.
D2L_BASE_URL=

# D2L API versions your tenant reports at <D2L_BASE_URL>/d2l/api/versions/ (defaults: 1.96 / 1.62).
D2L_LE_VERSION=
D2L_LP_VERSION=

# Suffix on current course-offering codes, e.g. _FALL_26. Derived from today's date when empty.
D2L_TERM_SUFFIX=

# Comma-separated discussion topic titles to ignore (housekeeping threads). Default: Questions
D2L_SKIP_TOPICS=

# Where scraped coursework, your progress marks and prep artifacts live. Default: ./data
COURSEWORK_DATA_DIR=

# Command the "Prepare next" button runs, e.g. an agent CLI given agent/coursework-prep.md.
# Leave empty to disable the button.
COURSEWORK_PREP_COMMAND=
